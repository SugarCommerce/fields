{
  "name": "sugarcommerce/fields",
  "description": "Admin form fields for WordPress, written once: every field type with its markup, sanitising, rules and conditions, on a metabox, a term form, a profile or quick and bulk edit, stored in any meta or an option, with icon sets, a colour control and search over posts, users and terms.",
  "homepage": "https://github.com/SugarCommerce/fields",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3",
    "sugarcommerce/geo": "dev-main",
    "sugarcommerce/plugin": "dev-main",
    "sugarcommerce/security": "dev-main",
    "sugarcommerce/text": "dev-main"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "suggest": {
    "sugarcommerce/money": "Supplies the currencies preset and the options of the currency field type."
  },
  "repositories": [
    {
      "type": "path",
      "url": "../geo",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../security",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../dates",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../plugin",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../text",
      "options": {
        "symlink": false
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "SugarCommerce\\Fields\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\Fields\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php",
      "/tests/stubs/",
      "/tests/Screens/stubs.php",
      "/tests/fixtures/"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist",
    "docs:verify": "php bin/verify-docs.php --calls=FieldSet,PostFields::register,TermFields::register,UserFields::register,QuickEditFields::register,BulkEditFields::register README.md",
    "test:js": "node tests/js/smoke.js",
    "test:all": [
      "@test",
      "@test:js"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/SugarCommerce/fields/issues",
    "source": "https://github.com/SugarCommerce/fields"
  },
  "keywords": [
    "wordpress",
    "fields",
    "forms",
    "settings",
    "meta",
    "metabox",
    "icons",
    "accessibility"
  ]
}
